<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE generatorConfiguration
        PUBLIC "-//mybatis.org//DTD MyBatis Generator Configuration 1.0//EN"
        "http://mybatis.org/dtd/mybatis-generator-config_1_0.dtd">

<generatorConfiguration>
    <context id="DB2Tables" targetRuntime="MyBatis3">
        <jdbcConnection driverClass="com.mysql.cj.jdbc.Driver"
                        connectionURL="jdbc:mysql://localhost:3306/RBAC_db?useSSL=false&amp;serverTimezone=UTC"
                        userId="root"
                        password="ildp009-" />

        <javaModelGenerator targetPackage="com.springPractice.Entity" targetProject="src/main/java"/>
        <sqlMapGenerator targetPackage="mapper" targetProject="src/main/resources/mybatis"/>
        <javaClientGenerator type="XMLMAPPER" targetPackage="com.springPractice.mapper" targetProject="src/main/java"/>

        <table schema="RBAC_db" tableName="account" domainObjectName="Account"/>
        <table schema="RBAC_db" tableName="role" domainObjectName="Role"/>
        <table schema="RBAC_db" tableName="permission" domainObjectName="Permission"/>
        
    </context>
</generatorConfiguration>