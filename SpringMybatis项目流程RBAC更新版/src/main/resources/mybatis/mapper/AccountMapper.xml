  <select id="selectByPermission" resultMap="selectByPerResultMap">
  	SELECT 
        a.id          as account_id,
        a.login_name  as login_name,
        a.password,
        a.nick_name,
        a.age         AS age,
        a.location    AS location,
        
        r.id          as role_id,
        r.name        as role_name,
        r.addAccount,
        r.createTime,
        r.lastUpdateTime,
        r.lastUpdateAccount,
        r.isDeleted,
        
        p.id		  AS permission_id,
        p.uni,
        p.name		  AS permission_name,
        p.c,
        p.r,
        p.u,
        p.d
    FROM account AS a 
    INNER JOIN account_role AS ar 
    ON a.id = ar.account_id
    INNER JOIN role AS r
    ON r.id = ar.role_id
    
    LEFT JOIN role_permission AS rp
    ON r.id = rp.role_id
    LEFT JOIN permission AS p
    ON p.id = rp.permission_id;
  </select>
